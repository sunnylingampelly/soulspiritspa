# ---------------------------------------------------------------------------
# Google Ads conversion tracking (see lib/google-ads.ts)
#
# Leave any of these empty (or a placeholder) and tracking stays fully
# off — no events are sent, but every phone/WhatsApp/directions link keeps
# working normally. A dev-only console warning explains what's missing.
#
# IMPORTANT: the Google Ads *customer ID* (shown as e.g. 406-315-8174 in the
# Ads UI) is NOT any of the values below. These must come from the Google
# *tag*, found under Tools & Settings > Conversions in Google Ads.
# ---------------------------------------------------------------------------

# The Google tag ID for this Ads account. Always "AW-" followed by digits.
# Tools & Settings > Conversions > (any conversion action) > Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion label for "Website Phone Click" (Primary, Count: One).
# Create this conversion action in Google Ads first, then copy its label
# from the generated tag snippet (the part after "AW-XXXXXXX/").
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=

# Conversion label for "Confirmed Booking" (Primary, Count: One).
# Not wired up to anything yet — the site has no real booking backend to
# confirm against. See trackConfirmedBooking() in lib/google-ads.ts.
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=

# Conversion label for "WhatsApp Click" (Secondary, Count: One).
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Conversion label for "Directions Click" (Secondary, Count: One).
NEXT_PUBLIC_GOOGLE_ADS_DIRECTIONS_LABEL=
